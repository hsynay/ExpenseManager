# Copy this file to .env for local development and fill in real values.
# Never commit .env. On Render, set the same names in the Environment tab.

# --- Database (Supabase, session pooler, port 5432) ---
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
# Optional: size of the connection pool
# DB_POOL_MIN=1
# DB_POOL_MAX=10

# --- App ---
# Signs the session cookie. Long random string, the same on every restart.
SECRET_KEY=
# true in production (HTTPS only), false for local http
SESSION_COOKIE_SECURE=false

# --- Scheduled jobs: daily summary e-mail ---
# Secret for /tasks/daily-summary. If empty, the address refuses every request.
# Send it in the X-Task-Token header (or ?token=). Make it long and random.
TASK_TOKEN=
# Mail server. If any of these is empty the job skips sending and returns 200.
# Port 587 uses STARTTLS, port 465 uses TLS from the start.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# One address, or several separated by commas
MAIL_TO=
